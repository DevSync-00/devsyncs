{
  "name": "devsync",
  "displayName": "DevSync",
  "description": "AI-powered schema sync for modern development - Real-time schema mismatch detection and fixes",
  "version": "0.1.0",
  "publisher": "devsync",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Database",
    "Linters"
  ],
  "keywords": [
    "schema",
    "database",
    "prisma",
    "postgresql",
    "sync",
    "migration",
    "devops"
  ],
  "activationEvents": [
    "onLanguage:prisma",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "workspaceContains:**/schema.prisma",
    "workspaceContains:**/.devsync/config.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "devsync": [
        {
          "id": "devsyncSidebar",
          "name": "DevSync",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devsync",
          "title": "DevSync",
          "icon": "$(database)"
        }
      ]
    },
    "commands": [
      {
        "command": "devsync.scan",
        "title": "Scan Schema",
        "category": "DevSync"
      },
      {
        "command": "devsync.generateMigration",
        "title": "Generate Migration",
        "category": "DevSync"
      },
      {
        "command": "devsync.viewReport",
        "title": "View Scan Report",
        "category": "DevSync"
      },
      {
        "command": "devsync.openDashboard",
        "title": "Open Dashboard",
        "category": "DevSync"
      },
      {
        "command": "devsync.applyFix",
        "title": "Apply Fix",
        "category": "DevSync"
      },
      {
        "command": "devsync.sidebar.scan",
        "title": "Scan Schema",
        "icon": "$(search)"
      },
      {
        "command": "devsync.sidebar.migrate",
        "title": "Generate Migration",
        "icon": "$(tools)"
      },
      {
        "command": "devsync.sidebar.init",
        "title": "Initialize Project",
        "icon": "$(add)"
      },
      {
        "command": "devsync.sidebar.showOutput",
        "title": "View Output",
        "icon": "$(output)"
      },
      {
        "command": "devsync.sidebar.viewFix",
        "title": "View Suggested Fix"
      },
      {
        "command": "devsync.sidebar.openConfig",
        "title": "Open Config File"
      },
      {
        "command": "devsync.sidebar.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "DevSync",
      "properties": {
        "devsync.apiUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "DevSync dashboard API URL"
        },
        "devsync.projectId": {
          "type": "string",
          "default": "",
          "description": "DevSync project ID"
        },
        "devsync.databaseConnection": {
          "type": "string",
          "default": "",
          "description": "Database connection string (optional, can be set in .devsync/config.json)"
        },
        "devsync.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline diagnostics for schema mismatches"
        },
        "devsync.autoScan": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan on file save"
        },
        "devsync.aiAnalysis": {
          "type": "boolean",
          "default": false,
          "description": "Use AI to analyze codebase and infer schema from code patterns"
        },
        "devsync.useOllama": {
          "type": "boolean",
          "default": false,
          "description": "Use Ollama (local, free) instead of OpenAI for AI analysis"
        },
        "devsync.ollamaModel": {
          "type": "string",
          "default": "llama3.2:3b",
          "description": "Ollama model name"
        },
        "devsync.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama API URL"
        },
        "devsync.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key for AI analysis (or set OPENAI_API_KEY env var)"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "devsync.scan",
          "when": "resourceExtname == .prisma || workspaceHasPrismaSchema",
          "group": "devsync"
        },
        {
          "command": "devsync.generateMigration",
          "when": "resourceExtname == .prisma || workspaceHasPrismaSchema",
          "group": "devsync"
        }
      ],
      "editor/title": [
        {
          "command": "devsync.scan",
          "when": "editorLangId == prisma",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "devsync.sidebar.refresh",
          "when": "view == devsyncSidebar",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "devsync.sidebar.viewFix",
          "when": "view == devsyncSidebar && viewItem == mismatch-fix",
          "group": "inline"
        }
      ]
    },
    "problemMatchers": [],
    "problemPatterns": []
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run compile-tests",
    "compile-tests": "tsc -p ./tsconfig.tests.json",
    "test": "node ./out/test/src/test/runTest.js",
    "test-watch": "npm run compile && npm run test",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.3.0",
    "glob": "^10.0.0",
    "mocha": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}

