# Supabase public browser config.
# These exact NEXT_PUBLIC_* names are required by signup/login pages.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-side aliases are accepted by API routes, but browser pages cannot read
# non-NEXT_PUBLIC variables.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Required for server-only admin operations:
# - device-code auth storage
# - background jobs
# - future server-side maintenance tasks
# Never expose this to client-side code and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alias also supported:
# SUPABASE_SECRET_KEY=your-service-role-key

# GitHub App configuration for per-user private repository access.
# Store the complete PEM private key as a multiline value in production.
# Set the GitHub App post-installation Setup URL to:
# https://your-dashboard.example/api/github/callback
# Enable "Redirect on update" so repository access changes return to DevSync.
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=devsync
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Recommended on hosts where multiline variables are error-prone:
# GITHUB_APP_PRIVATE_KEY_BASE64=base64-encoded-complete-pem-file

# Optional fallback for development only. Production users should connect the
# GitHub App instead of sharing a deployment-level personal token.
# GITHUB_TOKEN=github_pat_...

# Required for DevSync-issued CLI/extension JWTs.
# Use at least 32 random characters. Rotate if exposed.
DEVSYNC_TOKEN_SIGNING_SECRET=replace-with-32-plus-random-characters

# Optional AI providers.
AI_PROVIDER=puter
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_URL=https://api.deepseek.com/v1

# Optional dashboard URL for device auth links in non-local deployments.
# Also use this as the Supabase production Site URL.
NEXT_PUBLIC_DASHBOARD_URL=https://dev-sync.dev

# Transactional auth email is sent by Supabase through Resend SMTP:
# 1. Authentication > Providers > Email: enable "Confirm email".
# 2. Verify bitlabsbuild.com in Resend and create a Resend API key.
# 3. In Supabase SMTP Settings use smtp.resend.com:465, username "resend",
#    the Resend API key as password, and devsync@bitlabsbuild.com as sender.
# Keep the Resend API key in Supabase, not this file.
# Disable Resend click and open tracking for the sending domain. Tracking
# rewrites verification links and can cause authentication links to fail.

# Google OAuth is configured in Google Cloud and Supabase, not application env.
# Enable the Google provider in Supabase and allow:
# https://dev-sync.dev/auth/callback
