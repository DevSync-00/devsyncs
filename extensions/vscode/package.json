{
  "name": "devsync",
  "displayName": "DevSync",
  "description": "AI-powered schema sync for modern development - Real-time schema mismatch detection and fixes",
  "version": "0.1.0",
  "publisher": "devsync",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Database",
    "Linters"
  ],
  "keywords": [
    "schema",
    "database",
    "prisma",
    "postgresql",
    "sync",
    "migration",
    "devops"
  ],
  "activationEvents": [
    "onLanguage:prisma",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "workspaceContains:**/schema.prisma",
    "workspaceContains:**/.devsync/config.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devsync.scan",
        "title": "Scan Schema",
        "category": "DevSync"
      },
      {
        "command": "devsync.generateMigration",
        "title": "Generate Migration",
        "category": "DevSync"
      },
      {
        "command": "devsync.viewReport",
        "title": "View Scan Report",
        "category": "DevSync"
      },
      {
        "command": "devsync.openDashboard",
        "title": "Open Dashboard",
        "category": "DevSync"
      },
      {
        "command": "devsync.applyFix",
        "title": "Apply Fix",
        "category": "DevSync"
      }
    ],
    "configuration": {
      "title": "DevSync",
      "properties": {
        "devsync.apiUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "DevSync dashboard API URL"
        },
        "devsync.apiKey": {
          "type": "string",
          "default": "",
          "description": "DevSync API key (JWT token)"
        },
        "devsync.projectId": {
          "type": "string",
          "default": "",
          "description": "DevSync project ID"
        },
        "devsync.databaseConnection": {
          "type": "string",
          "default": "",
          "description": "Database connection string (optional, can be set in .devsync/config.json)"
        },
        "devsync.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline diagnostics for schema mismatches"
        },
        "devsync.autoScan": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan on file save"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "devsync.scan",
          "when": "resourceExtname == .prisma || workspaceHasPrismaSchema",
          "group": "devsync"
        },
        {
          "command": "devsync.generateMigration",
          "when": "resourceExtname == .prisma || workspaceHasPrismaSchema",
          "group": "devsync"
        }
      ],
      "editor/title": [
        {
          "command": "devsync.scan",
          "when": "editorLangId == prisma",
          "group": "navigation"
        }
      ]
    },
    "problemMatchers": [],
    "problemPatterns": []
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run compile-tests",
    "compile-tests": "tsc -p ./",
    "test": "node ./out/test/runTest.js",
    "test-watch": "npm run compile && npm run test",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.3.0",
    "glob": "^10.0.0",
    "mocha": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}

