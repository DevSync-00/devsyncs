{
  "name": "devsync",
  "displayName": "DevSync",
  "description": "AI-powered schema sync for modern development - Real-time schema mismatch detection and fixes",
  "version": "0.1.0",
  "publisher": "devsync",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Database",
    "Linters"
  ],
  "keywords": [
    "schema",
    "database",
    "prisma",
    "postgresql",
    "sync",
    "migration",
    "devops"
  ],
  "activationEvents": [
    "onLanguage:prisma",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "workspaceContains:**/schema.prisma",
    "workspaceContains:**/.devsync/config.json",
    "onView:devsyncChat",
    "onCommand:devsync.chat.focus",
    "onCommand:devsync.chat.newConversation",
    "onCommand:devsync.chat.login",
    "onCommand:devsync.chat.logout"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "devsync": [
        {
          "id": "devsyncSidebar",
          "name": "DevSync",
          "when": "workspaceFolderCount > 0"
        },
        {
          "type": "webview",
          "id": "devsyncChat",
          "name": "DevSync Chat",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devsync",
          "title": "DevSync",
          "icon": "$(database)"
        }
      ]
    },
    "commands": [
      {
        "command": "devsync.scan",
        "title": "Scan Schema",
        "category": "DevSync"
      },
      {
        "command": "devsync.generateMigration",
        "title": "Generate Migration",
        "category": "DevSync"
      },
      {
        "command": "devsync.viewReport",
        "title": "View Scan Report",
        "category": "DevSync"
      },
      {
        "command": "devsync.openDashboard",
        "title": "Open Dashboard",
        "category": "DevSync"
      },
      {
        "command": "devsync.applyFix",
        "title": "Apply Fix",
        "category": "DevSync"
      },
      {
        "command": "devsync.previewFix",
        "title": "Preview Fix",
        "category": "DevSync"
      },
      {
        "command": "devsync.showDiff",
        "title": "Show Diff",
        "category": "DevSync"
      },
      {
        "command": "devsync.batchApplyFixes",
        "title": "Apply All Fixes",
        "category": "DevSync"
      },
      {
        "command": "devsync.previewMigrationImpact",
        "title": "Preview Migration Impact",
        "category": "DevSync"
      },
      {
        "command": "devsync.showSchemaComparison",
        "title": "Show Schema Comparison",
        "category": "DevSync"
      },
      {
        "command": "devsync.showMigrationHistory",
        "title": "Show Migration History",
        "category": "DevSync"
      },
      {
        "command": "devsync.showStatus",
        "title": "Show Schema Status",
        "category": "DevSync"
      },
      {
        "command": "devsync.fix",
        "title": "Propose Fixes",
        "category": "DevSync"
      },
      {
        "command": "devsync.status",
        "title": "Check Schema Status",
        "category": "DevSync"
      },
      {
        "command": "devsync.apply",
        "title": "Apply Fixes (Blocked)",
        "category": "DevSync"
      },
      {
        "command": "devsync.sidebar.scan",
        "title": "Scan Schema",
        "icon": "$(search)"
      },
      {
        "command": "devsync.sidebar.migrate",
        "title": "Generate Migration",
        "icon": "$(tools)"
      },
      {
        "command": "devsync.sidebar.init",
        "title": "Initialize Project",
        "icon": "$(add)"
      },
      {
        "command": "devsync.sidebar.showOutput",
        "title": "View Output",
        "icon": "$(output)"
      },
      {
        "command": "devsync.sidebar.status",
        "title": "Check Status",
        "icon": "$(check)"
      },
      {
        "command": "devsync.sidebar.fix",
        "title": "Propose Fixes",
        "icon": "$(wrench)"
      },
      {
        "command": "devsync.sidebar.apply",
        "title": "Apply Fixes",
        "icon": "$(play)"
      },
      {
        "command": "devsync.openERD",
        "title": "Open ER Diagram",
        "category": "DevSync",
        "icon": "$(graph)"
      },
      {
        "command": "devsync.captureSchemaSnapshot",
        "title": "Capture Schema Snapshot",
        "category": "DevSync",
        "icon": "$(camera)"
      },
      {
        "command": "devsync.captureSchemaFromDatabase",
        "title": "Capture Schema from Database",
        "category": "DevSync"
      },
      {
        "command": "devsync.sidebar.viewFix",
        "title": "View Suggested Fix"
      },
      {
        "command": "devsync.sidebar.jumpToSource",
        "title": "Jump to Source"
      },
      {
        "command": "devsync.sidebar.filterPreset",
        "title": "Set Sidebar Filter"
      },
      {
        "command": "devsync.sidebar.openConfig",
        "title": "Open Config File"
      },
      {
        "command": "devsync.sidebar.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "devsync.sidebar.search",
        "title": "Search in Sidebar",
        "icon": "$(search)"
      },
      {
        "command": "devsync.sidebar.clearSearch",
        "title": "Clear Search",
        "icon": "$(clear-all)"
      },
      {
        "command": "devsync.chat.focus",
        "title": "Focus DevSync Chat",
        "category": "DevSync",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "devsync.chat.newConversation",
        "title": "New Chat Conversation",
        "category": "DevSync",
        "icon": "$(add)"
      },
      {
        "command": "devsync.chat.login",
        "title": "Sign In to DevSync",
        "category": "DevSync",
        "icon": "$(account)"
      },
      {
        "command": "devsync.chat.logout",
        "title": "Sign Out of DevSync",
        "category": "DevSync",
        "icon": "$(sign-out)"
      },
      {
        "command": "devsync.onboarding.start",
        "title": "Start Onboarding",
        "category": "DevSync",
        "icon": "$(play)"
      },
      {
        "command": "devsync.onboarding.restart",
        "title": "Restart Onboarding",
        "category": "DevSync",
        "icon": "$(refresh)"
      },
      {
        "command": "devsync.onboarding.quickStart",
        "title": "Quick Start Template",
        "category": "DevSync",
        "icon": "$(rocket)"
      },
      {
        "command": "devsync.queue.pause",
        "title": "Pause Task Queue",
        "category": "DevSync",
        "icon": "$(debug-pause)"
      },
      {
        "command": "devsync.queue.resume",
        "title": "Resume Task Queue",
        "category": "DevSync",
        "icon": "$(play)"
      },
      {
        "command": "devsync.undoLast",
        "title": "Undo Last Operation",
        "category": "DevSync",
        "icon": "$(discard)"
      }
    ],
    "configuration": {
      "title": "DevSync",
      "properties": {
        "devsync.apiUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "DevSync dashboard API URL"
        },
        "devsync.apiKey": {
          "type": "string",
          "default": "",
          "description": "DevSync API key (JWT token)"
        },
        "devsync.projectId": {
          "type": "string",
          "default": "",
          "description": "DevSync project ID"
        },
        "devsync.databaseConnection": {
          "type": "string",
          "default": "",
          "description": "Database connection string (optional, can be set in .devsync/config.json)"
        },
        "devsync.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline diagnostics for schema mismatches"
        },
        "devsync.autoScan": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan on file save"
        },
        "devsync.aiAnalysis": {
          "type": "boolean",
          "default": false,
          "description": "Use AI to analyze codebase and infer schema from code patterns"
        },
        "devsync.useOllama": {
          "type": "boolean",
          "default": false,
          "description": "Use Ollama (local, free) instead of OpenAI for AI analysis"
        },
        "devsync.ollamaModel": {
          "type": "string",
          "default": "llama3.2:3b",
          "description": "Ollama model name"
        },
        "devsync.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama API URL"
        },
        "devsync.ai.provider": {
          "type": "string",
          "enum": [
            "puter",
            "openai",
            "ollama",
            "deepseek"
          ],
          "default": "puter",
          "description": "AI provider to use for chat and analysis"
        },
        "devsync.analyzerUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "DevSync dashboard URL for device authentication (authentication endpoints are in the dashboard, not a separate analyzer service)"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "devsync.scan",
          "when": "resourceExtname == .prisma || workspaceHasPrismaSchema",
          "group": "devsync"
        },
        {
          "command": "devsync.generateMigration",
          "when": "resourceExtname == .prisma || workspaceHasPrismaSchema",
          "group": "devsync"
        }
      ],
      "editor/title": [
        {
          "command": "devsync.scan",
          "when": "editorLangId == prisma",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "devsync.sidebar.refresh",
          "when": "view == devsyncSidebar",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "devsync.sidebar.viewFix",
          "when": "view == devsyncSidebar && viewItem == mismatch-fix",
          "group": "inline"
        }
      ]
    },
    "problemMatchers": [],
    "problemPatterns": []
  },
  "keybindings": [
    {
      "command": "devsync.sidebar.scan",
      "key": "ctrl+shift+d s",
      "when": "view == devsyncSidebar"
    },
    {
      "command": "devsync.sidebar.filterPreset",
      "key": "ctrl+shift+d f",
      "when": "view == devsyncSidebar"
    },
    {
      "command": "devsync.sidebar.jumpToSource",
      "key": "ctrl+shift+d j",
      "when": "view == devsyncSidebar && viewItem == mismatch-*"
    },
    {
      "command": "devsync.sidebar.viewFix",
      "key": "ctrl+shift+d v",
      "when": "view == devsyncSidebar && viewItem == mismatch-fix"
    }
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run compile:webview",
    "compile:webview": "webpack --config src/erd/webview/webpack.config.js",
    "watch": "tsc -watch -p ./",
    "watch:webview": "webpack --config src/erd/webview/webpack.config.js --watch",
    "pretest": "npm run compile; npm run compile-tests",
    "compile-tests": "tsc -p ./tsconfig.test.json",
    "test": "node ./out/test/runTest.js",
    "test-watch": "npm run compile; npm run test",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "quality": "npm run lint; npm run format:check; npm run compile",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.15.6",
    "@types/sqlite3": "^5.1.0",
    "@types/vscode": "^1.80.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vscode/test-electron": "^2.3.0",
    "glob": "^11.0.0",
    "mocha": "^10.0.0",
    "ts-loader": "^9.5.0",
    "typedoc": "^0.28.15",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.0.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "dompurify": "^3.0.9",
    "marked": "^12.0.2",
    "mysql2": "^3.15.3",
    "pg": "^8.16.3",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite3": "^5.1.7"
  }
}
