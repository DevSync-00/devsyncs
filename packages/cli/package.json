{
  "name": "@dev-sync/cli",
  "version": "0.1.2",
  "description": "Dev-Sync CLI - AI-powered schema sync for modern development",
  "type": "module",
  "bin": {
    "devsync": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevSync-00/devsyncs.git",
    "directory": "packages/cli"
  },
  "homepage": "https://dev-sync.dev",
  "bugs": {
    "url": "https://github.com/DevSync-00/devsyncs/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --test --test-force-exit tests/all.test.js",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "devops",
    "schema",
    "database",
    "sync",
    "prisma",
    "postgresql"
  ],
  "author": "Dev-Sync <devsync@bitlabsbuild.com>",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.3",
    "tsx": "^4.19.2"
  }
}
